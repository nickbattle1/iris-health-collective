rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // role is a custom claim on the token, set server side. a role in a
    // firestore doc could be edited by whoever owns that doc, so nothing in
    // here reads one. no claim means member
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // what a provider is allowed to change on their own listing.
    // accreditations, inclusionBasis, ratings and listingStatus are missing on
    // purpose, a practice can't award itself a badge or move its own ranking
    function providerEditableFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'practiceName', 'contactPhone', 'hours', 'languages',
        'telehealth', 'inPerson', 'bulkBilling', 'wheelchairAccess',
        'auslanAvailable', 'afterHours', 'approachTags', 'photoUrl', 'updatedAt'
      ]);
    }

    match /providers/{providerId} {
      allow read: if resource.data.listingStatus == 'published' || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isOwner(resource.data.ownerUid) && providerEditableFields());

      /* approved reviews are public, your own is visible to you whatever its
         status, and staff see everything.

         no client writes at all. submitReview creates it as pending and
         moderateReview decides it, so a practice cannot write its own rating
         and nobody can approve their own review. the doc id is the author's
         uid, which is what makes one review per person per practice free */
      match /reviews/{reviewId} {
        // isOwner first on purpose. checking whether you have already reviewed
        // reads a document that may not exist, and resource.data on a missing
        // document fails the rule outright
        allow read: if isOwner(reviewId) || isAdmin() || resource.data.status == 'approved';
        allow create, update, delete: if false;
      }
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();

      // you can edit your own profile, you can't hand yourself a role
      allow update: if (isOwner(uid) || isAdmin())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    // what the charity is running. same as resources, read by anyone, written
    // by the seed only
    match /events/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // published guides. readable by anyone with no account, which is the point
    match /resources/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // what the charity offers. anyone can read so the wizard works without an
    // account. nobody can write, these are seeded and then maintained by staff
    // through the admin SDK
    match /services/{serviceId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if false;
    }

    // one number per slot, how many confirmed bookings it holds. no names, no
    // uids, nothing that identifies anyone, which is what makes it safe to
    // read publicly. the booking transaction is the only writer
    match /availability/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    // readable by the person who made it and by staff. writable by neither.
    //
    // every write goes through createBooking or cancelBooking instead.
    // stopping a double booking means reading the clashing bookings and
    // writing the new one atomically, and a client can't be trusted with
    // either. denying create here isn't belt and braces, it's the rule that
    // makes the transaction mean anything
    match /bookings/{bookingId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    // contact form submissions. staff read them, nobody writes from a browser.
    //
    // submitEnquiry is the only writer, and it takes no auth, so this is the
    // rule doing the work. an open create here would let anyone flood the
    // collection or read back what someone else reported about a practice
    match /enquiries/{enquiryId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    /* the moderation queue asks for every pending review across all 40
       providers at once, which is a collection group query. those are matched
       by path pattern rather than by the nested rule above, so without this
       block the queue reads nothing. staff only, because a query for pending
       reviews spans documents nobody else should see */
    match /{path=**}/reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

